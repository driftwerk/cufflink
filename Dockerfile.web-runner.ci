FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl tini xz-utils && \
    curl -fsSLo /tmp/node.tar.xz https://nodejs.org/dist/v24.22.1/node-v24.22.1-linux-x64.tar.xz && \
    echo "6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6  /tmp/node.tar.xz" | sha256sum -c - && \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
    rm /tmp/node.tar.xz && \
    rm -rf /var/lib/apt/lists/*

COPY cufflink-web-runner /usr/local/bin/cufflink-web-runner

RUN mkdir -p /apps && chown 10001:10001 /apps

ENV APPS_DIR=/apps

EXPOSE 3100

USER 10001:10001

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["cufflink-web-runner"]
