FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini && rm -rf /var/lib/apt/lists/*

COPY cufflink-ext-runner /usr/local/bin/cufflink-ext-runner

RUN mkdir -p /apps /tmp/cufflink-ext && chown 10001:10001 /apps /tmp/cufflink-ext

ENV APPS_DIR=/apps EXT_SOCKET_DIR=/tmp/cufflink-ext

EXPOSE 3200

USER 10001:10001

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["cufflink-ext-runner"]
