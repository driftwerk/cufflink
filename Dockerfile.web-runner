FROM rust:1.99.0-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY types/ types/
COPY migrate/ migrate/
COPY pgcodec/ pgcodec/
COPY secrets/ secrets/
COPY storage/ storage/
COPY db/ db/
COPY settings/ settings/
COPY shutdown/ shutdown/
COPY telemetry/ telemetry/
COPY nats/ nats/
COPY native/ native/
COPY platform/ platform/
COPY worker/ worker/
COPY sdk/ sdk/
COPY sdk-macros/ sdk-macros/
COPY cli/ cli/
COPY cufflink-fn/ cufflink-fn/
COPY supervisor/ supervisor/
COPY web-runner/ web-runner/
COPY ext-runner/ ext-runner/
COPY test-guests/ test-guests/
COPY testkit/ testkit/
COPY examples/ examples/

RUN cargo build --release -p cufflink-web-runner

FROM node:24.21.0-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

RUN apt-get update && apt-get install -y ca-certificates tini && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/cufflink-web-runner /usr/local/bin/cufflink-web-runner

RUN mkdir -p /apps && chown 10001:10001 /apps

ENV APPS_DIR=/apps

EXPOSE 3100

USER 10001:10001

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["cufflink-web-runner"]
