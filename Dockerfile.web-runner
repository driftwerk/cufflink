FROM rust:1.100.0-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37 AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY types/ types/
COPY migrate/ migrate/
COPY pgcodec/ pgcodec/
COPY sql-parse/ sql-parse/
COPY sql-parser/ sql-parser/
COPY secrets/ secrets/
COPY storage/ storage/
COPY db/ db/
COPY settings/ settings/
COPY shutdown/ shutdown/
COPY telemetry/ telemetry/
COPY nats/ nats/
COPY native/ native/
COPY platform/ platform/
COPY worker/ worker/
COPY sdk/ sdk/
COPY sdk-macros/ sdk-macros/
COPY cli/ cli/
COPY cufflink-fn/ cufflink-fn/
COPY model/ model/
COPY supervisor/ supervisor/
COPY web-runner/ web-runner/
COPY ext-runner/ ext-runner/
COPY test-guests/ test-guests/
COPY testkit/ testkit/
COPY examples/ examples/

RUN cargo build --release -p cufflink-web-runner

FROM node:26.13.1-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc

RUN apt-get update && apt-get install -y ca-certificates tini && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/cufflink-web-runner /usr/local/bin/cufflink-web-runner

RUN mkdir -p /apps && chown 10001:10001 /apps

ENV APPS_DIR=/apps

EXPOSE 3100

USER 10001:10001

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["cufflink-web-runner"]
