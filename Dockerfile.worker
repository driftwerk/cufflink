FROM rust:1.99.1-slim-bookworm@sha256:24707e70a4f1e23d9a7b25202ec43126d28a52294b96aad5c670df1fd1f1d400 AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev clang libclang-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY types/ types/
COPY migrate/ migrate/
COPY pgcodec/ pgcodec/
COPY sql-parse/ sql-parse/
COPY sql-parser/ sql-parser/
COPY secrets/ secrets/
COPY storage/ storage/
COPY db/ db/
COPY settings/ settings/
COPY shutdown/ shutdown/
COPY telemetry/ telemetry/
COPY nats/ nats/
COPY native/ native/
COPY platform/ platform/
COPY worker/ worker/
COPY sdk/ sdk/
COPY sdk-macros/ sdk-macros/
COPY cli/ cli/
COPY cufflink-fn/ cufflink-fn/
COPY model/ model/
COPY supervisor/ supervisor/
COPY web-runner/ web-runner/
COPY ext-runner/ ext-runner/
COPY test-guests/ test-guests/
COPY testkit/ testkit/
COPY examples/ examples/

RUN cargo build --release -p cufflink-worker -p cufflink-sql-parser

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

RUN apt-get update && apt-get install -y ca-certificates tini && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/cufflink-worker /usr/local/bin/cufflink-worker
COPY --from=builder /app/target/release/cufflink-sql-parser /usr/local/bin/cufflink-sql-parser

USER 10001:10001

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["cufflink-worker"]
