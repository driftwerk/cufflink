{
  "name": "catalog-service",
  "version": "0.0.0",
  "tables": [
    {
      "name": "loans",
      "columns": [
        {
          "name": "id",
          "column_type": "uuid",
          "primary_key": true,
          "nullable": false,
          "auto_generate": true,
          "default_value": null,
          "unique": false
        },
        {
          "name": "borrower_id",
          "column_type": "uuid",
          "primary_key": false,
          "nullable": false,
          "auto_generate": false,
          "default_value": null,
          "unique": false
        },
        {
          "name": "status",
          "column_type": "text",
          "primary_key": false,
          "nullable": false,
          "auto_generate": false,
          "default_value": null,
          "unique": false
        },
        {
          "name": "created_at",
          "column_type": "timestamp",
          "primary_key": false,
          "nullable": false,
          "auto_generate": true,
          "default_value": null,
          "unique": false
        }
      ],
      "soft_delete": false,
      "owner_field": "borrower_id",
      "auth_required": true,
      "permission_area": "loans",
      "owner_self_service": false
    },
    {
      "name": "volumes",
      "columns": [
        {
          "name": "id",
          "column_type": "uuid",
          "primary_key": true,
          "nullable": false,
          "auto_generate": true,
          "default_value": null,
          "unique": false
        },
        {
          "name": "book_id",
          "column_type": "uuid",
          "primary_key": false,
          "nullable": false,
          "auto_generate": false,
          "default_value": null,
          "unique": false
        }
      ],
      "soft_delete": false,
      "auth_required": false,
      "permission_area": "volumes",
      "owner_self_service": false
    }
  ],
  "cells": [],
  "events": [],
  "subscriptions": [
    {
      "subject": "dw.{tenant}.fines.paid",
      "handler": "on_fine_paid",
      "handler_type": "wasm",
      "config": {}
    },
    {
      "subject": "cufflink.tick.hourly",
      "handler": "sweep_stale",
      "handler_type": "wasm",
      "config": {},
      "stream": "CUFFLINK_TICKS"
    },
    {
      "subject": "dw.{tenant}.loans.deleted",
      "handler": "cascade",
      "handler_type": "delete_cascade",
      "config": {}
    }
  ],
  "custom_routes": [
    {
      "method": "POST",
      "path": "/stripe/webhook",
      "handler": "stripe_webhook",
      "posture": {
        "kind": "public",
        "reason": "Stripe-signed webhook"
      }
    },
    {
      "method": "GET",
      "path": "/me/loans",
      "handler": "my_loans",
      "posture": {
        "kind": "owner",
        "field": "borrower_id"
      }
    },
    {
      "method": "GET",
      "path": "/loans/summary",
      "handler": "loans_summary",
      "posture": {
        "kind": "authenticated"
      }
    },
    {
      "method": "POST",
      "path": "/loans/export",
      "handler": "export_loans",
      "job": {
        "timeout_secs": 900,
        "max_attempts": 1
      },
      "posture": {
        "kind": "permission",
        "area": "loans",
        "operation": "view"
      }
    },
    {
      "method": "POST",
      "path": "/loans/rebuild",
      "handler": "rebuild",
      "job": {
        "timeout_secs": 600,
        "max_attempts": 3
      },
      "posture": {
        "kind": "permission",
        "area": "loans",
        "operation": "edit"
      }
    },
    {
      "method": "POST",
      "path": "/loans/proxy",
      "handler": "proxy_loans",
      "posture": {
        "kind": "permission",
        "area": "loans",
        "operation": "edit"
      },
      "forward_auth": true
    },
    {
      "method": "GET",
      "path": "/legacy",
      "handler": "legacy"
    }
  ],
  "mode": "wasm",
  "authorization": {
    "areas": [
      {
        "name": "loans",
        "operations": [
          "view",
          "create",
          "edit",
          "delete"
        ]
      },
      {
        "name": "volumes",
        "operations": [
          "view"
        ]
      }
    ],
    "default_roles": [
      {
        "name": "librarian",
        "description": "Front desk",
        "permissions": [
          "loans:*",
          "volumes:view"
        ]
      },
      {
        "name": "admin",
        "description": "Everything",
        "permissions": [
          "*"
        ]
      }
    ]
  },
  "on_migrate": "handle_on_migrate",
  "publishes": [
    "dw.shared.loans.>"
  ],
  "required_platform_features": [
    "route_posture"
  ],
  "graphql": true
}
